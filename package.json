{
  "name": "companyflags",
  "version": "0.2.0",
  "description": "A self-hosted feature flag and remote config server, read with OpenFeature.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "companyflags": "./server/cli.ts"
  },
  "exports": {
    "./config": "./server/config.ts",
    "./plugins": "./server/plugins/index.ts",
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "remote-config",
    "openfeature",
    "flagd",
    "self-hosted",
    "dimensions",
    "cdn"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.ts\" \"vite\"",
    "start": "node server/index.ts",
    "serve": "vite build && node server/index.ts",
    "server": "node --watch server/index.ts",
    "build": "vite build",
    "test": "node --test --test-timeout=120000 \"test/*.test.ts\"",
    "test:pg": "FF_TEST_PG=${FF_TEST_PG:-postgres://postgres:postgres@localhost:55432/postgres} node --test --test-timeout=120000 --test-concurrency=4 \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "oxlint server web/src test packages",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "cli": "node server/cli.ts"
  },
  "dependencies": {
    "@better-auth/sso": "^1.7.25",
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^2.1.8",
    "better-auth": "^1.7.25",
    "hono": "^4.13.19",
    "jsonata": "2.2.2",
    "kysely": "^0.29.9",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@companyflags/ui": "workspace:*",
    "@openfeature/core": "^1.12.0",
    "@openfeature/ofrep-provider": "^0.2.5",
    "@openfeature/ofrep-web-provider": "^0.4.3",
    "@openfeature/server-sdk": "^1.23.0",
    "@openfeature/web-sdk": "^1.10.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "concurrently": "^10.0.7",
    "jose": "^6.2.17",
    "oxlint": "1.94.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "samlify": "^2.15.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
