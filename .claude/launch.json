{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "companyflags",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=8787",
        "pnpm",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "companyflags-built",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "serve"
      ],
      "port": 8787
    },
    {
      "name": "console-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "vite",
        "--port",
        "5200",
        "--strictPort"
      ],
      "port": 5200
    },
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "docs",
        "exec",
        "vitepress",
        "preview",
        "--port",
        "4173"
      ],
      "port": 4173
    }
  ]
}
