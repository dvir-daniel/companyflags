# CompanyFlags settings. Copy what you need into your environment, or into .env for docker compose (the server
# itself doesn't read .env files).

# --- Database -------------------------------------------------------------------------------
# Production: a Postgres 15+ server. Without it, data lives in an embedded Postgres (PGlite) folder.
# DATABASE_URL=postgres://user:pass@host:5432/flags?sslmode=verify-full
# FF_DB_POOL=10
# Without DATABASE_URL: the embedded database's folder (default ./data)
# FF_DATA_DIR=./data

# --- Server ---------------------------------------------------------------------------------
# PORT=8787
# HOST=0.0.0.0
# NODE_ENV=production          # required in production: refuses unsafe settings
# Sign-in rate limits are on unless NODE_ENV is development or test.
# Behind a proxy or CDN: your proxies' addresses or ranges. Only connections from them are believed about the
# client's address (X-Forwarded-For past the proxies, or the header below); any other counts as its own address.
# FF_TRUSTED_PROXIES=10.0.0.0/8
# A header the proxy sets itself, read instead of X-Forwarded-For. Needs FF_TRUSTED_PROXIES (the server won't start
# without it).
# FF_CLIENT_IP_HEADER=x-real-ip

# --- Sign-in (Better Auth) ------------------------------------------------------------------
# Required in production. Make a secret with: openssl rand -base64 32
# It signs sessions and makes the setup link the server prints while nobody has an account.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://flags.example.com
# Identity providers on a private network (single sign-on), comma-separated origins
# BETTER_AUTH_TRUSTED_ORIGINS=https://idp.internal.example.com
# People at these email domains may join as viewers by signing in with a provider
# FF_SIGNUP_DOMAINS=example.com

# Providers: each is turned on by setting both values
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# --- CDN ------------------------------------------------------------------------------------
# Purge Cloudflare's cache for an environment after each publish (both values needed)
# CF_ZONE_ID=
# CF_API_TOKEN=

# --- Webhooks -------------------------------------------------------------------------------
# Webhooks out go to public addresses only. Origins on your own network they may reach, comma-separated:
# FF_WEBHOOK_ALLOWED_ORIGINS=http://ci.internal:8080
