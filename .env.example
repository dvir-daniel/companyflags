# CompanyFeatures settings. Copy what you need into your environment, or into .env for docker compose (the server
# itself doesn't read .env files).

# --- Database -------------------------------------------------------------------------------
# Production: a Postgres 15+ server. Without it, data lives in an embedded Postgres (PGlite) folder.
# DATABASE_URL=postgres://user:pass@host:5432/flags?sslmode=verify-full
# FF_DB_POOL=10
# Local data folder (default ./data); ":memory:" keeps everything in memory until the server stops.
# FF_DATA_DIR=./data

# --- Server ---------------------------------------------------------------------------------
# PORT=8787
# HOST=0.0.0.0
# NODE_ENV=production          # required in production: turns on rate limits and refuses unsafe settings
# Behind a proxy or CDN, where sign-in rate limits find the client's address (default: the connection's own address):
# a header the proxy sets itself, or X-Forwarded-For past your proxies' addresses
# FF_CLIENT_IP_HEADER=cf-connecting-ip
# FF_TRUSTED_PROXIES=10.0.0.0/8

# --- Sign-in (Better Auth) ------------------------------------------------------------------
# Required in production. Make a secret with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://flags.example.com
# Identity providers on a private network (single sign-on), comma-separated origins
# BETTER_AUTH_TRUSTED_ORIGINS=https://idp.internal.example.com
# People at these email domains may join as viewers by signing in with a provider
# FF_SIGNUP_DOMAINS=example.com

# Providers: each is turned on by setting both values
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# --- CDN ------------------------------------------------------------------------------------
# Purge Cloudflare's cache for an environment after each publish (both values needed)
# CF_ZONE_ID=
# CF_API_TOKEN=

# --- Trying it -------------------------------------------------------------------------------
# Fill a new, empty database with the sample data (environments, apps, dimensions, entities and flags)
# FF_DEMO=1
